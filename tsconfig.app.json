{
  "compilerOptions": {
    // node_modules é montado somente-leitura no build de deployment do
    // Replit (autoscale) -- o caminho padrão do scaffold do Vite (dentro de
    // node_modules/.tmp) fazia o `tsc -b` travar ali antes de compilar
    // qualquer coisa. Path fora de node_modules, sempre gravável.
    "tsBuildInfoFile": "./.tsbuildinfo/app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
