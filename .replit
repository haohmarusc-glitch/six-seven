modules = ["nodejs-22", "postgresql-16"]

run = "npm run dev:full"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build:full"]
run = ["npm", "run", "start"]

[objectStorage]
defaultBucketID = "replit-objstore-b270335f-9501-401a-989a-4614bb1aa646"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 3999
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 80
